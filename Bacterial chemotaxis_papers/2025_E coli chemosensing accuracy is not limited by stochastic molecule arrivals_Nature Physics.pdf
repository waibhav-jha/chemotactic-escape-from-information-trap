               <rdf:li rdf:parseType="Resource">
                  <pdfaSchema:namespaceURI>http://www.niso.org/schemas/jav/1.0/</pdfaSchema:namespaceURI>
                  <pdfaSchema:prefix>jav</pdfaSchema:prefix>
                  <pdfaSchema:schema>NISO</pdfaSchema:schema>
                  <pdfaSchema:property>
                     <rdf:Seq>
